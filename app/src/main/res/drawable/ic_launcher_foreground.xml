<?xml version="1.0" encoding="utf-8"?>
<!-- Иконка приложения: одна капсула, один цвет, без градиентов и деталей.

     Требование было — чистая простота, поэтому здесь ровно одна фигура.
     Капсула повёрнута на 45° и помещается в безопасную зону adaptive icon
     (круг радиусом 36 от центра 54,54): дальние точки силуэта отстоят от
     центра на 26, то есть запас есть.

     Цвет один и тот же для всех состояний — и в обычном виде, и в
     монохромной маске тем оформления, где система берёт только альфу.
     Поворот сделан через <group>, а не в координатах: координаты читаются
     как обычная капсула и их легко поправить, если поменяется длина. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="45">
        <path
            android:fillColor="#F2F8F9"
            android:pathData="M41,41 L67,41 A13,13 0 0 1 67,67 L41,67 A13,13 0 0 1 41,41 Z" />
    </group>
</vector>